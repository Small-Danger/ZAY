
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Le catalogue de produits est public en lecture, écriture pour l'admin (prototypage: libre)
    match /products/{productId} {
      allow read, write: if true;
    }
    
    // Catégories et sous-catégories sont publiques en lecture
    match /categories/{categoryId} {
      allow read, write: if true;
      
      match /subcategories/{subcategoryId} {
        allow read, write: if true;
      }
    }
    
    // Les profils utilisateurs ne sont accessibles que par leur propriétaire
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /addresses/{addressId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

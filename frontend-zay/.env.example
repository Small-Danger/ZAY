# =========================
# ZAY Frontend — local
# =========================

# URL de l’API Nest (préfixe /api inclus)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Origine backend pour les fichiers /uploads/...
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
# URL publique du site (sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:9002
# SSR Docker : hostname interne, pas localhost
API_INTERNAL_URL=http://backend-zay:4000/api

# =========================
# Railway — variables du service `frontend`
# NEXT_PUBLIC_* est cuit au BUILD Docker : les définir AVANT le 1er deploy.
# Ne PAS définir PORT (Railway l’injecte).
# =========================
#
# NEXT_PUBLIC_API_URL=https://${{backend.RAILWAY_PUBLIC_DOMAIN}}/api
# NEXT_PUBLIC_API_ORIGIN=https://${{backend.RAILWAY_PUBLIC_DOMAIN}}
# NEXT_PUBLIC_SITE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
# API_INTERNAL_URL=http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:${{backend.PORT}}/api

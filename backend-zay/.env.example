# =========================
# ZAY Backend — local
# =========================

PORT=4000
NODE_ENV=development

# PostgreSQL (service Docker `postgres-zay`)
# Port hôte 55432 (évite les conflits avec PostgreSQL Windows local)
DATABASE_URL=postgresql://zay:zay_secret@127.0.0.1:55432/zay_db?schema=public

# CORS — origines front autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:9002,http://127.0.0.1:9002

# Vague B — Auth JWT
JWT_SECRET=change-me-zay-dev-secret-min-32-chars!!
JWT_EXPIRES_IN=7d

# Compte admin créé au démarrage s’il n’existe pas
ADMIN_EMAIL=admin@zay.local
ADMIN_PASSWORD=Admin123!

# URL du front (retour Stripe Checkout)
FRONTEND_URL=http://localhost:9002

# Clés Stripe sandbox (sk_test_...) — ne jamais committer la vraie clé
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# =========================
# Railway — variables du service `backend`
# Noms de services attendus : Postgres, backend, frontend
# Ne PAS définir PORT (Railway l’injecte).
# =========================
#
# NODE_ENV=production
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# JWT_SECRET=<générer une chaîne unique ≥ 32 caractères>
# JWT_EXPIRES_IN=7d
# ADMIN_EMAIL=<ton email admin>
# ADMIN_PASSWORD=<mot de passe unique, pas Admin123!>
# FRONTEND_URL=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
# CORS_ORIGINS=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#   Webhook Stripe → https://<domaine-backend>/api/payments/webhook
#   événements : checkout.session.completed,
#   checkout.session.async_payment_succeeded,
#   checkout.session.expired,
#   checkout.session.async_payment_failed
#
# Les images /uploads sont sur le disque du conteneur (perdues au redeploy)
# sauf volume Railway. OK pour un test privé.
